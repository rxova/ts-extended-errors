{
  "name": "ts-extended-errors",
  "version": "0.0.0",
  "type": "module",
  "description": "Typed, serializable errors for TypeScript: a base class that survives subclassing, a factory for error taxonomies, and cause-chain helpers.",
  "keywords": [
    "typescript",
    "error",
    "errors",
    "custom-error",
    "error-cause",
    "serialize",
    "typed-errors"
  ],
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:exports": "publint --strict && attw --pack .",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "publint": "^0.3.22",
    "tsdown": "^0.22.14",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/experiments.git",
    "directory": "packages/ts-extended-errors"
  },
  "bugs": {
    "url": "https://github.com/rxova/experiments/issues"
  },
  "homepage": "https://github.com/rxova/experiments/tree/main/packages/ts-extended-errors#readme"
}
