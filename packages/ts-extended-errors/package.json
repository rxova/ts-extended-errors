{
  "name": "@rxova/ts-extended-errors",
  "version": "0.2.0",
  "type": "module",
  "description": "Typed, serializable errors for TypeScript: a base class that survives subclassing, a factory for error taxonomies, and cause-chain helpers.",
  "keywords": [
    "typescript",
    "error",
    "errors",
    "custom-error",
    "custom-errors",
    "error-class",
    "error-handling",
    "error-cause",
    "cause",
    "error-chain",
    "serialize",
    "deserialize",
    "error-serialization",
    "serialize-error",
    "json",
    "instanceof",
    "typed-errors"
  ],
  "license": "MIT",
  "author": "Jonatan Kruszewski",
  "sideEffects": false,
  "files": [
    "dist",
    "llms.txt"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check:exports": "publint --strict && attw --pack .",
    "pack:smoke": "node --import tsx ../tooling/src/pack-smoke.ts",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@repo/config": "workspace:*",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/ts-extended-errors.git",
    "directory": "packages/ts-extended-errors"
  },
  "bugs": {
    "url": "https://github.com/rxova/ts-extended-errors/issues"
  },
  "homepage": "https://github.com/rxova/ts-extended-errors/tree/main/packages/ts-extended-errors#readme"
}
