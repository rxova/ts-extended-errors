{
  // The shared strict preset, with three settings overridden. `exactOptionalPropertyTypes`
  // stays off: most consumers compile without it, and the type tests pin what
  // they see (`code: string | undefined` passed to `defineError` infers `string`).
  // The DOM libs and `jsx` are kept from the settings this repository had before.
  "extends": "@rxova/repo-config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "exactOptionalPropertyTypes": false
  }
}
